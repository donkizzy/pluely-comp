# =============================================================
# Pluely Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.

# --- DeepSeek AI Provider ---
# Configure these in the Pluely UI under Settings > AI Provider > DeepSeek
# API_KEY: Your DeepSeek API key (entered in the UI, not here)
# MODEL: deepseek-chat (default, entered in the UI)
# Base URL is baked into the provider: https://api.deepseek.com

# --- Local Faster-Whisper Transcription Service ---
# The transcription service runs on localhost:8787 by default.
# Override the port if needed:
TRANSCRIPTION_PORT=8787

# Whisper model to use (default: small.en)
WHISPER_MODEL=small.en

# Compute type for Faster-Whisper (default: int8)
WHISPER_COMPUTE_TYPE=int8

# --- Pluely API / licensed mode ---
# These are only needed if using the Pluely cloud API (licensed mode).
# For local DeepSeek + Faster-Whisper usage, these can be left empty.
# API_ACCESS_KEY is read at runtime and is never compiled into the binary.
# Development loads .env at startup; release builds use the process environment.
# APP_ENDPOINT=
# API_ACCESS_KEY=
# PAYMENT_ENDPOINT=
# POSTHOG_API_KEY=
